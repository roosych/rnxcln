# Loaded instead of .env whenever APP_ENV=testing (see phpunit.xml), which
# Laravel resolves BEFORE bootstrapping — so this is the actual source of
# truth for the test DB connection, not phpunit.xml's <env> block. Without
# this file, Laravel falls back to .env's real DB_CONNECTION=mysql /
# DB_HOST=mariadb during the app-bootstrap step (which runs after PHPUnit's
# own env overrides), and a RefreshDatabase test wipes the real dev database.
# See the comment in phpunit.xml for how this was discovered.
APP_ENV=testing
APP_KEY=base64:joxQt9zJgjJ1m3UZ+3AR0e9Isg1lqNLMNdO/UoOq1qM=
APP_DEBUG=true

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

BCRYPT_ROUNDS=4
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
